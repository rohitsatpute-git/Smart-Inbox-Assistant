# Copy to .env — never commit real secrets.

# Google Gemini (Python AI service)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Gmail IMAP (Spring Boot poller)
GMAIL_USER=your.address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_POLL_MS=30000
IMAP_MAX_PER_POLL=5

# Optional: SMTP send script (same Gmail account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Oracle (host JDBC when Spring runs on the machine; ignored inside Compose)
ORACLE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
ORACLE_USER=smartinbox
ORACLE_PASSWORD=smartinbox

# Python AI service (host URL when Spring runs on the machine; ignored inside Compose)
AI_SERVICE_URL=http://localhost:8000

# Reviewer basic auth
REVIEWER_USER=reviewer
REVIEWER_PASSWORD=reviewer123

# Attachment storage
ATTACHMENT_DIR=./data/attachments
